# Native Firefox + Phoenix, layered via rpm-ostree. Phoenix's own support
# table marks Flatpak Firefox as broken (not just discouraged) — native is
# the only supported path here, not a fallback taken for consistency with
# Brave. COPR project and phoenix package both verified live (HTTP 200).

RUN dnf copr enable -y celenity/copr && \
    dnf makecache && \
    rpm-ostree install firefox phoenix

# Firefox reads exactly ONE policies.json, no managed-directory merge like
# Chromium gets — this COPY must come after the install line above so it
# overwrites whatever the phoenix package itself places at this path, not
# the other way around. Content is Phoenix's own phoenix-core.json plus a
# 3-URL Extensions.Install (uBlock Origin, Consent-O-Matic, NordPass) —
# uBlock matters here specifically because Firefox has no Shields
# equivalent, unlike the Brave build where it'd be redundant.
COPY policies.json /etc/firefox/policies/policies.json

# NOT bakeable — the profile directory doesn't exist until first native
# launch. After rebase + reboot + first Firefox launch, manually append
# this same directory's supplemental-user.js to the new profile's user.js
# (webcam 4K default, hardware decode/encode, WebRTC leak mitigation,
# Phoenix Extended tier switch via browser.phoenix.extended).

# Verify after rebase + reboot:
#   rpm -q firefox phoenix
#   about:config -> confirm browser.phoenix.extended = true (after user.js applied)
#   about:support -> Media section -> confirm hardware decode is active
#   about:addons -> confirm all 3 extensions installed (a dead XPI URL fails
#     silently — actually check, don't assume)
