[Unit]
Description=Generate NVIDIA CDI spec so containers can use the GPU
After=local-fs.target
ConditionPathExists=/usr/bin/nvidia-ctk

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/mkdir -p /etc/cdi
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
# Regenerated each boot: driver updates change device paths, and a stale
# spec silently breaks GPU passthrough into podman.

[Install]
WantedBy=multi-user.target
